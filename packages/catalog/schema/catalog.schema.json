          "features": {
            "minItems": 2,
            "maxItems": 6,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "icon": {
                  "type": "string",
                  "enum": [
                    "sparkles",
                    "zap",
                    "shield",
                    "heart",
                    "star",
                    "coffee",
                    "truck",
                    "clock",
                    "users",
                    "chart",
                    "globe",
                    "lock",
                    "smile",
                    "leaf",
                    "gift",
                    "phone"
                  ]
                },
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "description": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "icon",
                "title",
                "description"
              ],
              "additionalProperties": false
            }
          },
          "skeleton": {
            "type": "boolean"
          }
        },
        "required": [
          "title",
          "subtitle",
          "features"
        ],
        "additionalProperties": false
      },
      "placeholder": {
        "title": "…",
        "subtitle": "…",
        "features": [
          {
            "icon": "sparkles",
            "title": "…",
            "description": "…"
          },
          {
            "icon": "zap",
            "title": "…",
            "description": "…"
          },
          {
            "icon": "shield",
            "title": "…",
            "description": "…"
          }
        ],
        "skeleton": true
      }
    },
