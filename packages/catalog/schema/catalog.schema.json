    "FeatureGrid": {
      "kind": "block",
      "description": "Grid of product features or benefits, each with an icon, title and short description.",
      "slots": [],
      "events": [],
      "root": false,
      "props": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
