{
  "components": {
    "Page": {
      "kind": "layout",
      "description": "Page root. Holds every section of one screen in vertical order.",
      "slots": [
        "default"
      ],
      "events": [],
      "root": true,
      "props": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "skeleton": {
            "type": "boolean"
          }
        },
        "required": [
          "title"
        ],
        "additionalProperties": false
      },
      "placeholder": {
        "title": "…",
        "skeleton": true
      }
    },
    "Navbar": {
      "kind": "block",
