        "required": [
          "brand",
          "links",
          "ctaLabel"
        ],
        "additionalProperties": false
      },
      "placeholder": {
        "brand": "…",
        "links": [
          "…",
          "…",
          "…"
        ],
        "ctaLabel": "…",
        "skeleton": true
      }
    },
