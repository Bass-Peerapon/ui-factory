# Copy to .env and fill in the keys. .env is git-ignored.

# --- LLM (Google AI Studio / Gemini API) ---
GEMINI_API_KEY=
# Model for full-page fill and edits. Check AI Studio for current model names.
GEMINI_MODEL=
# Cheaper/faster model for small patches and fallback structure step.
GEMINI_FAST_MODEL=

# --- Jev (TypeSafe AI) ---
JEV_API_KEY=
JEV_BASE_URL=https://api.typesafe.ai/v1
# Pin the exact model version; the json-render integration is experimental.
JEV_MODEL=jev-1.13.0

# --- Composer ---
# jev | llm  (llm = LLM-only baseline / fallback)
COMPOSER_MODE=jev
COMPOSER_PORT=8081
COMPOSER_URL=http://localhost:8081

# --- API (Go) ---
API_PORT=8080
DATABASE_PATH=./data/ui-factory.db
# Max retries per agent tool call before applying partial result
AGENT_MAX_RETRIES=3

# --- Web (Vite) ---
WEB_PORT=5173
VITE_API_URL=http://localhost:8080
